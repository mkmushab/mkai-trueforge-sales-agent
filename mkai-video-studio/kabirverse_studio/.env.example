# =============================================================================
# KabirVerse 3D (v5 Mega-Edition) - TEMPLATE. Copy to .env and fill in your keys.
# Paste your GeneralCompute / OpenAI-compatible keys below, no quotes.
# =============================================================================
OPENAI_BASE_URL=https://api.generalcompute.com/v1

# --- 3-model council (a missing key is fine: the others take over) -----------
DEEPSEEK_API_KEY=paste_your_new_deepseek_key_here
DEEPSEEK_MODEL=DeepSeek V3.2

GPT_OSS_API_KEY=paste_your_new_gpt_oss_key_here
GPT_OSS_MODEL=gpt-oss-120b

GEMMA_API_KEY=paste_your_new_gemma_key_here
GEMMA_MODEL=Gemma 4 31B-IT

# --- Schedule (24h clock, comma separated) in TIMEZONE below -----------------
# Shorts/Reels per day (20-25 s each) - one slot per short
SHORT_TIMES=11:00,17:00,21:30
# ONE long YouTube video per day (2:00-2:30, 16:9). Use LONG_VIDEO_TIME=off to disable.
LONG_VIDEO_TIME=19:00
TIMEZONE=Asia/Kolkata
# A slot still runs if the laptop wakes up late, up to this many minutes after it
GRACE_MINUTES=45

# --- Chrome (started by start_chrome_agent.*) --------------------------------
CHROME_CDP_URL=http://localhost:9222

# --- Uploading ---------------------------------------------------------------
# false = browser opens the upload form, fills title/caption, YOU press Publish.
# true  = the agent presses Publish itself (do this only after a few good runs).
AUTO_PUBLISH_YOUTUBE=false
AUTO_PUBLISH_INSTAGRAM=false
YT_VISIBILITY=public
# Tick YouTube's "altered / synthetic content" disclosure
YT_DISCLOSE_AI=true

# --- Voice -------------------------------------------------------------------
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+12%
TTS_PITCH=+2Hz

# --- Content & v5 Mega-Cast / Environments -----------------------------------
# CONTENT_STYLE: clean = no slang | desi = playful slang (saala, bakchod, kamina...) |
#                bleeped = desi + strong words are replaced by a censor BEEP (recommended)
CONTENT_STYLE=bleeped

# FORMAT:
#   solo         = 1 character (Kabir or female lead Riya)
#   couple_roast = 2 characters (Boy + Girl viral banter)
#   dialogue     = 3-4 characters talking
#   talent_roast = India's Got Latent style panel (3 judges + contestant with red buzzers)
#   panel_5_6    = 5-6 characters on stage together
#   mix          = random pick each time
SHORT_FORMAT=mix
LONG_FORMAT=mix

# DEFAULT_BACKGROUND:
#   auto | talent_stage | jungle | home_room | podcast_studio | street_chai |
#   college_canteen | office_boardroom | gym | news_room | cyber_studio
DEFAULT_BACKGROUND=auto

# Automatically cut 9:16 vertical Shorts/Reels from every long 16:9 video
AUTO_CUT_SHORTS_FROM_LONG=true

# Local Web Studio port (http://localhost:8765)
WEB_STUDIO_PORT=8765

# --- Branding ----------------------------------------------------------------
CHANNEL_NAME=MkVerse 3D
SOCIAL_HANDLE=@mkverse.3d
CHARACTER_NAME=Kabir 3D
# Text under the avatar. Leave this line commented = shows SOCIAL_HANDLE.
# Set "VIDEO_WATERMARK=" (empty) to hide it, or any text to replace it.
# VIDEO_WATERMARK=
