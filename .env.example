# ==============================================================================
# MK-AI TrueForge Self-Improving Sales & Leads Agent (.env.example)
# Copy to .env to run with live LLM calls and a running TrueForge server.
# ==============================================================================

# TrueForge Server URL (Started via: npx @truefoundry/trueforge@latest)
TRUEFORGE_URL=http://localhost:8790

# OpenAI-Compatible Model Endpoint & 3-Tier Keys
MK_BASE_URL=https://api.generalcompute.com/v1
MK_MAIN_MODEL=gpt-oss-120b
MK_MAIN_API_KEY=your_main_api_key_here

MK_HEAVY_MODEL=deepseek-v3.2
MK_HEAVY_API_KEY=your_heavy_api_key_here

MK_FAST_MODEL=gemma-4-31B-it
MK_FAST_API_KEY=your_fast_api_key_here
