# ==============================================================================
# MK AI v6 — Elite 8-Agent Business & Sales Orchestra Configuration
# Copy this file to .env and fill in your 3 LLM API keys + Gmail/LinkedIn.
# You can also enter these directly inside the Electron Desktop App UI!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YOUR 3 LLM API KEYS (gptoss120B, Deepseek V3.2, gemma 31B)
# ------------------------------------------------------------------------------
MK_BASE_URL=https://api.generalcompute.com/v1

# Key 1: MAIN Engine — gptoss120B (Sales Outreach, Marketing Campaigns, Proposals)
MK_MAIN_API_KEY=your_gptoss120b_api_key_here
MK_MAIN_MODEL=gpt-oss-120b

# Key 2: HEAVY Engine — Deepseek V3.2 (USA vs India Pricing Math, Market Intelligence, AI CEO, Cap Tables)
MK_HEAVY_API_KEY=your_deepseek_v3_2_api_key_here
MK_HEAVY_MODEL=deepseek-v3.2

# Key 3: FAST Engine — gemma 31B (BANT Lead Qualification, Support Triage, Maps & Web Scraping)
MK_FAST_API_KEY=your_gemma_31b_api_key_here
MK_FAST_MODEL=gemma-4-31B-it

# ------------------------------------------------------------------------------
# 2. GMAIL & LINKEDIN CONNECTORS (For Sales & Outreach Orchestra)
# ------------------------------------------------------------------------------
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# LinkedIn Assisted Laptop Chrome Session (~/ChromeAgentProfile) or Cookie
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-profile
LINKEDIN_LI_AT_COOKIE=your_optional_linkedin_li_at_cookie_here

# Optional EspoCRM Instance (Built-in SQLite EspoCRM runs automatically!)
ESPOCRM_URL=http://127.0.0.1:8081
ESPOCRM_API_KEY=your_optional_espocrm_api_key_here

# ------------------------------------------------------------------------------
# 3. WEB AGENT & MAPS AGENT SERVICES
# ------------------------------------------------------------------------------
TINYFISH_API_KEY=your_tinyfish_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
GOSOM_MAPS_API_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 4. BACKEND & GATEKEEPER SECURITY
# ------------------------------------------------------------------------------
MK_BACKEND_HOST=127.0.0.1
MK_BACKEND_PORT=8765
MK_HUMAN_APPROVAL_REQUIRED=true
MK_APPROVAL_SECRET=your_hmac_approval_secret_here
MKAI_DEMO_MODE=0
